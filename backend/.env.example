# Copy to .env and adjust. Every value has a safe default for local development.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS (the mobile app does not need this).
CORS_ORIGINS=

# Postgres. Matches the db service in docker-compose.yml.
DATABASE_URL=postgres://profit:profit@localhost:5432/profit

# Signs access tokens. Required in production (32+ characters): openssl rand -base64 48
JWT_SECRET=

# Google OAuth client IDs whose ID tokens are accepted, comma-separated. Put the Web client ID
# here (Android Credential Manager tokens are issued for it). See docs/GOOGLE_SIGN_IN.md.
GOOGLE_CLIENT_IDS=

# Sign in without Google from emulators and local tests. Never on in production.
AUTH_DEV_LOGIN=false

# Folder for uploaded images (exercise photos). Back it up together with the database.
MEDIA_DIR=./data/media
