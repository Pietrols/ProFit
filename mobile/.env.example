# Copy to .env. EXPO_PUBLIC_ values are built into the app, so never put secrets here.

# Where the app finds the API. On a phone use your computer's LAN address, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Google OAuth Web client ID (Android Credential Manager asks Google for tokens issued to it).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Reversed iOS client ID, e.g. com.googleusercontent.apps.123-abc. Needed for iOS builds only.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Shows "Developer sign-in" in development builds. Needs AUTH_DEV_LOGIN=true on the API.
EXPO_PUBLIC_DEV_LOGIN=false
